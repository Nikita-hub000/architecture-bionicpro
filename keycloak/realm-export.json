{
  "realm": "reports-realm",
  "enabled": true,

  "browserFlow": "browser-mfa",

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,

  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],

  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "providerId": "basic-flow",
      "topLevel": true,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "mfa-forms-logic",
          "requirement": "ALTERNATIVE",
          "priority": 30
        }
      ]
    },
    {
      "alias": "mfa-forms-logic",
      "providerId": "basic-flow",
      "topLevel": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],

  "roles": {
    "realm": [
      { "name": "user", "description": "Regular user role" },
      { "name": "administrator", "description": "Administrator role" },
      { "name": "prothetic_user", "description": "Prothetic user role with report access" }
    ]
  },

  "groups": [
    { "name": "user", "realmRoles": ["user"] },
    { "name": "prothetic_user", "realmRoles": ["prothetic_user"] }
  ],

  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@example.com",
      "firstName": "User",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "user2",
      "enabled": true,
      "email": "user2@example.com",
      "firstName": "User",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["administrator"]
    },
    {
      "username": "prothetic1",
      "enabled": true,
      "email": "prothetic1@example.com",
      "firstName": "Prothetic",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"]
    },
    {
      "username": "prothetic2",
      "enabled": true,
      "email": "prothetic2@example.com",
      "firstName": "Prothetic",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"]
    },
    {
      "username": "prothetic3",
      "enabled": true,
      "email": "prothetic3@example.com",
      "firstName": "Prothetic",
      "lastName": "Three",
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"]
    }
  ],

  "clients": [
    {
      "clientId": "bionicpro-bff",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "very-secret-bff-key-12345",
      "redirectUris": ["http://localhost:8000/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "publicClient": false,
      "standardFlowEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000"
      }
    },
    {
      "clientId": "reports-api",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "oNwoLQdvJAvRcL89SydqCWCe5ry1jMgq",
      "bearerOnly": true
    }
  ],

  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "ldap",
        "providerId": "ldap",
        "subType": "org.keycloak.storage.UserStorageProvider",
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "importEnabled": ["true"],
          "editMode": ["READ_ONLY"],
          "syncRegistrations": ["false"],
          "vendor": ["other"],

          "connectionUrl": ["ldap://ldap:389"],
          "usersDn": ["ou=People,dc=example,dc=com"],
          "bindDn": ["cn=admin,dc=example,dc=com"],
          "bindCredential": ["admin"],

          "authType": ["simple"],
          "startTls": ["false"],

          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson"],

          "pagination": ["true"],
          "batchSizeForSync": ["1000"],
          "searchScope": ["1"]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "groups",
              "providerId": "group-ldap-mapper",
              "subType": "org.keycloak.storage.ldap.mappers.LDAPStorageMapper",
              "config": {
                "groups.dn": ["ou=Groups,dc=example,dc=com"],
                "group.name.ldap.attribute": ["cn"],
                "group.object.classes": ["groupOfNames"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["uid"],

                "preserve.group.inheritance": ["true"],
                "ignore.missing.groups": ["true"],
                "drop.non.existing.groups.during.sync": ["false"],

                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"],
                "groups.path": ["/"]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "subType": "org.keycloak.storage.ldap.mappers.LDAPStorageMapper",
              "config": {
                "user.model.attribute": ["email"],
                "ldap.attribute": ["mail"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "subType": "org.keycloak.storage.ldap.mappers.LDAPStorageMapper",
              "config": {
                "user.model.attribute": ["firstName"],
                "ldap.attribute": ["cn"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "subType": "org.keycloak.storage.ldap.mappers.LDAPStorageMapper",
              "config": {
                "user.model.attribute": ["lastName"],
                "ldap.attribute": ["sn"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"]
              }
            }
          ]
        }
      }
    ]
  },

  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Yandex ID",
      "providerId": "yandex",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "clientId": "//TODO replace with your client id",
        "clientSecret": "//TODO replace with your client secret",
        "syncMode": "IMPORT",
        "storeToken": "false",
        "acceptMessages": "false"
      }
    }
  ],

  "identityProviderMappers": [
    {
      "name": "yandex-email",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "default_email",
        "user.attribute": "email"
      }
    },
    {
      "name": "yandex-first-name",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "first_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "yandex-last-name",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "last_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "yandex-login-attr",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "login",
        "user.attribute": "yandex_login"
      }
    },
    {
      "name": "yandex-id-attr",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "id",
        "user.attribute": "yandex_id"
      }
    }
  ]
}